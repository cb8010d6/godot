config_version=5

[application]
run/main_loop_type="RTReadinessRegression"
run/main_scene="res://bootstrap.tscn"
config/name="RT Readiness Regression"
config/features=PackedStringArray("4.8", "Forward Plus")

[display]
window/size/viewport_width=640
window/size/viewport_height=360

[rendering]
renderer/rendering_method="forward_plus"
rendering_device/driver.windows="vulkan"
pathtracing/async_shader_compilation=true
